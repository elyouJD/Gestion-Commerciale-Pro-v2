rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function admin(){return request.auth != null && request.auth.uid == 'cO8W4xaU7xXWUedPhCXgiu5Amms1';}
  match /products/{id} {
   allow read: if resource.data.active == true || admin();
   allow write: if admin();
  }
  match /batches/{id} {
   allow read: if resource.data.active == true || admin();
   allow write: if admin();
  }
  match /orders/{id} {
   allow create: if request.resource.data.status == 'pending'
    && request.resource.data.keys().hasAll(['customer','items','estimatedTotal','status','createdAt'])
    && request.resource.data.items is list && request.resource.data.items.size() > 0
    && request.resource.data.items.size() <= 50;
   allow read, update, delete: if admin();
  }
  match /invoices/{id} { allow read, write: if admin(); }
  match /settings/{id} { allow read, write: if admin(); }
 }
}